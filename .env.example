NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/signal_dev
DATABASE_SSL=false
# Optional CA certificate (PEM, single line with \n) when DATABASE_SSL=true
DATABASE_CA=
# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
# Public URL of this API, only when the web app is on another origin and files are stored on local disk
PUBLIC_API_URL=
# Storage: leave S3_BUCKET empty to store files on local disk (development)
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_DIR=uploads
LOG_LEVEL=info
