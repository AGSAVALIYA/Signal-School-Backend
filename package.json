{
  "name": "signal-school-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "db:seed": "node scripts/seed.js",
    "create-owner": "node scripts/create-owner.js",
    "migrate-legacy": "node scripts/migrate-legacy.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/*.js\" \"tests/*.js\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/*.js\" \"tests/*.js\" eslint.config.js",
    "db:seed:perf": "node scripts/perf-seed.js",
    "thumbnails": "node scripts/make-thumbnails.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "./tests/globalSetup.js",
    "setupFiles": [
      "./tests/env.js"
    ],
    "maxWorkers": 1
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.3.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
